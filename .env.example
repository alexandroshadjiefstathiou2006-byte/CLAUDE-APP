# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"          # Postgres in prod: postgresql://user:pass@host:5432/studio
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Job execution: "inline" runs the worker inside the Next.js process (dev).
# In production set "external" and run `npm run worker` as a separate process.
JOB_RUNNER="inline"

# Storage: "local" (./storage) — swap for S3/R2 in src/server/storage
STORAGE_DRIVER="local"

# ── AI providers ─────────────────────────────────────────────────────
# Every provider defaults to "mock" so the app works with no keys.
# All provider calls happen server-side (worker); keys are never sent to the browser.
#
# Recommended real setup (one Google key covers photos AND talking UGC video):
#   SCRIPT_PROVIDER=anthropic  IMAGE_PROVIDER=google  VIDEO_PROVIDER=google
SCRIPT_PROVIDER="mock"   # mock | anthropic
IMAGE_PROVIDER="mock"    # mock | google | openai
VIDEO_PROVIDER="mock"    # mock | google | fal
VOICE_PROVIDER="mock"    # mock | elevenlabs   (only used with video engines without native audio, e.g. fal)

# Anthropic — scripts, hooks, product fidelity analysis.   Host: api.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Google Gemini API — image (Gemini image / "Nano Banana") + video (Veo 3).   Host: generativelanguage.googleapis.com
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GOOGLE_VIDEO_MODEL="veo-3.0-fast-generate-001"
VEO_DURATIONS="8"        # clip lengths the chosen Veo model supports, e.g. "4,6,8" for Veo 3.1

# OpenAI — GPT Image (reference-based edits).   Host: api.openai.com
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# fal.ai — Kling image-to-video (no audio).   Hosts: queue.fal.run, *.fal.media
FAL_KEY=""
FAL_VIDEO_MODEL="fal-ai/kling-video/v2.1/standard/image-to-video"

# ElevenLabs — voiceovers.   Host: api.elevenlabs.io
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Worker
WORKER_CONCURRENCY="4"
VIDEO_POLL_INTERVAL_MS="8000"

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
