# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"          # Postgres in prod: postgresql://user:pass@host:5432/studio
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Job execution: "inline" runs the worker inside the Next.js process (dev).
# In production set "external" and run `npm run worker` as a separate process.
JOB_RUNNER="inline"

# Storage: "local" (./storage) — swap for S3/R2 in src/server/storage
STORAGE_DRIVER="local"

# ── AI providers ─────────────────────────────────────────────────────
# Every provider defaults to "mock" so the app works with no keys.
SCRIPT_PROVIDER="mock"   # mock | anthropic
IMAGE_PROVIDER="mock"    # mock | openai
VIDEO_PROVIDER="mock"    # mock | fal
VOICE_PROVIDER="mock"    # mock | elevenlabs

ANTHROPIC_API_KEY=""     # scripts, hooks, product analysis (Claude)
OPENAI_API_KEY=""        # gpt-image-1 reference-based product/model photos
FAL_KEY=""               # fal.ai image-to-video
FAL_VIDEO_MODEL="fal-ai/kling-video/v2.1/standard/image-to-video"
ELEVENLABS_API_KEY=""    # voiceovers
ELEVENLABS_DEFAULT_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
